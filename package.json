{
  "name": "sourdough",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@dotenvx/dotenvx": "2.38.2",
      "cross-env": "10.1.0",
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "@types/node": "^26.6.6",
      "lucide-react": "^1.72.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.5",
      "convex": "^1.49.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@types/bun": "^1.4.4",
      "vitest": "^5.1.0"
    },
    "catalogs": {
      "effect": {
        "@effect/platform-bun": "4.1.4",
        "@effect/vitest": "4.1.4",
        "effect": "4.1.4"
      }
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "clean": "bun run clean:ws && git clean -xdf node_modules .turbo target",
    "clean:ws": "turbo run clean --filter='!//'",
    "dev": "bun run with-env turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "ox": "turbo run lint format typecheck",
    "ox:fix": "turbo run typecheck format:fix",
    "with-env": "cross-env-shell dotenvx run -f .env.$VERCEL_ENV --",
    "deploy": "bun tools/scripts/sync-vercel-env.ts preview && vercel deploy",
    "deploy:prod": "bun tools/scripts/sync-vercel-env.ts production && vercel deploy --prod"
  },
  "dependencies": {
    "@sourdough/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@effect/tsgo": "^0.67.7",
    "@hona/strobe": "^0.32.0",
    "@oxlint/plugins": "^1.93.0",
    "@shadcn/lint": "^0.2.5",
    "@sourdough/config": "workspace:*",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "effect": "catalog:effect",
    "eslint-plugin-turbo": "^2.11.11",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "portless": "^0.17.0",
    "react-doctor": "^0.9.22",
    "turbo": "^2.11.11",
    "typescript": "catalog:",
    "vercel": "^65.14.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "lefthook"
  ]
}
