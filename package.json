{
  "name": "sourdough",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "clean": "pnpm run clean:ws && git clean -xdf node_modules .turbo target",
    "clean:ws": "turbo run clean --filter='!//'",
    "dev": "pnpm with-env turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "ox": "turbo run lint format typecheck",
    "ox:fix": "turbo run typecheck format:fix",
    "with-env": "cross-env-shell dotenvx run -f .env.$VERCEL_ENV --",
    "deploy": "node tools/scripts/sync-vercel-env.ts preview && vercel deploy",
    "deploy:prod": "node tools/scripts/sync-vercel-env.ts production && vercel deploy --prod"
  },
  "dependencies": {
    "@sourdough/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@effect/tsgo": "^0.57.0",
    "@oxlint/plugins": "^1.89.0",
    "@shadcn/lint": "^0.2.3",
    "@sourdough/config": "workspace:*",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "effect": "catalog:effect",
    "eslint-plugin-turbo": "^2.11.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "portless": "^0.15.8",
    "react-doctor": "^0.9.14",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "vercel": "^59.24.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4"
}
