{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalTaskCommand": true,
  },
  "ui": "tui",
  "globalEnv": ["VERCEL_ENV"], // set in .envrc
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"],
      "env": ["VITE_*", "CONVEX_DEPLOY_KEY", "VERCEL"],
    },
    "test": {
      "dependsOn": ["^build"],
    },
    // oxlint/oxfmt run from the repo root, so they are Root Tasks.
    // `pnpm ox` and `pnpm ox:fix` are the only entry points.
    // `lint` and `format` are independent checks, so they stay
    // parallel; only the fixing variants are ordered, because `lint:fix`
    // rewrites the files `format:fix` then has to format.
    "//#lint": {
      "command": ["oxlint"],
    },
    "//#lint:fix": {
      "command": ["oxlint", "--fix", "--fix-suggestions", "--fix-dangerously"],
      "cache": false,
    },
    "//#format": {
      "command": ["oxfmt", "--check"],
    },
    "//#format:fix": {
      "command": ["oxfmt", "--write"],
      "dependsOn": ["//#lint:fix"],
      "cache": false,
    },
    // Full `tsc --noEmit` for the root-owned files.
    "//#typecheck": {
      "command": ["tsc", "--noEmit", "-p", "tsconfig.json"],
    },
    // Full `tsc --noEmit` per package program
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "with": ["//#typecheck"],
    },

    // `sourdough-rust` is the synthetic Cargo workspace package. Its built-in
    // `format` task is already uncached; `lint:fix`/`format:fix` are custom
    // task names, so they need `cache: false` explicitly -- otherwise a cache
    // hit silently skips `cargo fmt`.
    "sourdough-rust#lint": {
      "command": [
        "cargo",
        "clippy",
        "--workspace",
        "--locked",
        "--",
        "-D",
        "warnings",
      ],
    },
    "sourdough-rust#lint:fix": {
      "command": [
        "cargo",
        "clippy",
        "--workspace",
        "--locked",
        "--fix",
        "--allow-dirty",
        "--allow-staged",
      ],
      "cache": false,
    },
    "sourdough-rust#format": {
      "command": ["cargo", "fmt", "--all", "--check"],
    },
    "sourdough-rust#format:fix": {
      "command": ["cargo", "fmt", "--all"],
      "dependsOn": ["sourdough-rust#lint:fix"],
      "cache": false,
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["VITE_*", "PORTLESS_URL"],
    },
    "clean": {
      "cache": false,
    },
    "//#clean": {
      "cache": false,
    },
  },
}
