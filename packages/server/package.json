{
  "name": "@sourdough/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "clean": "git clean -xdf node_modules .turbo dist coverage",
    "dev": "bun run with-env portless run --name sourdough-server bun --watch src/index.ts",
    "start": "bun run with-env bun src/index.ts",
    "test": "bun --bun vitest run",
    "typecheck": "tsc --noEmit",
    "with-env": "cross-env-shell dotenvx run -f ../../.env.$VERCEL_ENV --",
    "cli": "bun src/bin.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:effect",
    "@sourdough/capability": "workspace:*",
    "@sourdough/contracts": "workspace:*",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@sourdough/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
