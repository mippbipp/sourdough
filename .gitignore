# nix
.direnv

# dotenvx-encrypted env files are versioned intentionally. Ciphertext is safe
# to commit and to ship in deploys (.vercelignore -> .gitignore); Vercel
# project env vars shadow them at runtime.
!.env.development
!.env.production

# Dependencies
node_modules
.pnp
.pnp.js

